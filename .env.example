# Copia este archivo a .env y cambia los valores. El docker-compose.yml lee
# de aqui, asi que si cambias un puerto o una clave, cambialo tambien en .env.

# Puerto de la base de datos. Cambialo si el 5432 ya esta ocupado.
DB_PORT=5432

# Puerto de la API. Se puede consultar directo en http://localhost:3000/api/v1/health
API_PORT=3000

# Puerto de la tienda. Es el que se abre en el navegador: http://localhost:8080
WEB_PORT=8080

# Puerto de pgAdmin, para ver la base con interfaz grafica.
PGADMIN_PORT=5050

# Contrasena de PostgreSQL. Cambiala antes de subir esto a un servidor.
DB_PASSWORD=postgres

# Clave con la que se firman los tokens de inicio de sesion.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=clave-local-de-docker-cambiar-en-produccion

# De donde se entra a la tienda. El nginx manda /api al backend, asi que
# normalmente no hay que tocar esto.
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Datos de acceso de pgAdmin.
PGADMIN_EMAIL=admin@tiendasmontano.bo
PGADMIN_PASSWORD=admin
